<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>serial3_description</name>
  <version>2.0.0</version>
  <description>URDF/Xacro, mallas y visualización en RViz2 del robot serial de 3 GDL (serial3)</description>
  <maintainer email="memorexduo@gmail.com">Juan Carlos Garcia</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>urdfdom</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
